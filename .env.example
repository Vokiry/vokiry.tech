# Server environment variables
NODE_ENV=production
PORT=3000

# Domain
DOMAIN=vokiry.tech

# Auth.js v5 — GitHub OAuth
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_secret
AUTH_URL=https://vokiry.tech
AUTH_TRUST_HOST=true

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated GitHub logins allowed into /admin
ADMIN_GITHUB_LOGINS=vokiry

NEXT_TELEMETRY_DISABLED=1
