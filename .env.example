# ==============================================================================
# vokiry.tech // Environment Configuration
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=3000
DOMAIN=vokiry.tech
NEXT_PUBLIC_SITE_URL=https://vokiry.tech

# Broadcaster & Identity
NEXT_PUBLIC_AUTHOR_NAME=vokiry
NEXT_PUBLIC_APP_VERSION=v0.3.0
NEXT_PUBLIC_STATION_ID=VOKIRY-01
NEXT_PUBLIC_TWITCH_CHANNEL=vokiry
NEXT_PUBLIC_TWITCH_MOCK_LIVE=false

# Social & Donate Links
NEXT_PUBLIC_GITHUB_URL=https://github.com/Vokiry
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/Vokiry
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/Vokkiry
NEXT_PUBLIC_EMAIL=vokiiry@gmail.com
NEXT_PUBLIC_DONATE_URL=https://www.donationalerts.com/r/vokiry

# Twitch Helix API (Optional for automated LIVE detection)
# Create application at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Auth.js v5 (GitHub OAuth for Admin & Guestbook)
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_random_secret
AUTH_URL=https://vokiry.tech
AUTH_TRUST_HOST=true
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGINS=vokiry

# Giscus (GitHub Discussions for Blog Comments)
NEXT_PUBLIC_GISCUS_REPO=Vokiry/vokiry.tech
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

NEXT_TELEMETRY_DISABLED=1
